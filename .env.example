# Supabase Connection Keys
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Connection URL (optional - if direct DB access is preferred)
# DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# JWT Secret for local tokens (change this to a secure random string)
JWT_SECRET=your-secure-jwt-secret-key-change-me

# SMTP Configuration for Email Verification Codes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Gain EX Security <your-email@gmail.com>

# Server Port (optional, defaults to 3000)
PORT=3000

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here
