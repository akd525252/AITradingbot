# Gain EX — Public Directory LiteSpeed / Apache Routing Rules
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Direct access to existing physical files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Route SPA sub-routes (/trade, /wallet, /profile, /history, /deposit, /withdraw) to index.html
  RewriteRule ^(.*)$ /index.html [L,QSA]
</IfModule>

# Disable directory listing
Options -Indexes
